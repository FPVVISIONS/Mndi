# Telegram API credentials: https://my.telegram.org/apps  (API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# TMDB v3 API key (or v4 read access token): https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Server
PORT=8787
HOST=127.0.0.1
# Directory for the SQLite database, encrypted Telegram session and caches
DATA_DIR=./data
# Optional: 32+ random characters used to encrypt the Telegram session.
# If empty, a key file is generated in DATA_DIR on first run.
SESSION_SECRET=

# Run with generated demo data and no Telegram login (UI development)
MARQUEE_MOCK=0
# Maximum size of the streaming chunk cache in MB
STREAM_CACHE_MB=512
